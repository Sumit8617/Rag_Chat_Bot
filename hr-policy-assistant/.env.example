# ============================================================
# HR Policy Assistant — Environment Configuration
# ============================================================

# Get your free API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Local embedding model (runs completely free on your machine)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_LOCAL_FILES_ONLY=true

# Persistent vector database directory
CHROMA_PATH=./chroma_db

# Hybrid retrieval tuning (Vector + Keyword)
TOP_K=5
RRF_K=60
RRF_VECTOR_WEIGHT=0.7
RRF_KEYWORD_WEIGHT=0.3

# Anti-hallucination grounding thresholds
GROUNDING_MAX_DISTANCE=0.75
GROUNDING_RRF_THRESHOLD_FRACTION=0.5
GROUNDING_TOP_N_CHECK=3
